{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@support/*": ["./Phase2-Playwright/support/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".solutions-check"]
}
